{
  "name": "academic-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{ts,vue,js}\" --max-warnings=0",
    "lint:fix": "eslint \"src/**/*.{ts,vue,js}\" --fix --max-warnings=0",
    "lint:strict": "eslint -c ../../eslint.typecheck.config.mjs \"src/**/*.{ts,vue}\" --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,json,css,scss,html,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,json,css,scss,html,md}\"",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm run format:check && pnpm run lint",
    "validate": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run lint:strict && pnpm run test && pnpm run build"
  },
  "dependencies": {
    "@241/platform": "workspace:*",
    "@241/shared": "workspace:*",
    "@241/ui": "workspace:*",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/vue3": "^7.0.2",
    "@internationalized/date": "^3.12.3",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/vue-query": "^5.101.4",
    "@tanstack/vue-table": "^8.21.3",
    "@vee-validate/zod": "^4.15.1",
    "@vueuse/core": "^14.4.0",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-vue-next": "^0.577.0",
    "pinia": "^3.0.4",
    "reka-ui": "^2.10.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.41",
    "vue-chrts": "^2.2.1",
    "vue-router": "^5.1.0",
    "vue-sonner": "^2.0.9",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.7",
    "vite": "^7.3.3",
    "vitest": "^3.2.4"
  }
}
