{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@/features/platform/*": ["../../packages/platform/src/features/*"],
      "@/shared/*": ["../../packages/shared/src/*"],
      "@/ui": ["../../packages/ui/src/index.ts"],
      "@/ui/*": ["../../packages/ui/src/components/ui/*/index.ts"],
      "@/ui/utils": ["../../packages/ui/src/utils/index.ts"],
      "@/master-data": ["../../packages/master-data/src/index.ts"],
      "@/master-data/*": ["../../packages/master-data/src/*"]
    },

    // The two sweep specs under `src/__tests__` read the repository off disk —
    // `node:fs/promises`, `node:path`, `process.cwd()`. `@vue/tsconfig`'s DOM
    // preset carries no node types, and until vitest 4 they resolved anyway
    // because vitest 3 pulled `@types/node` in transitively. It no longer
    // does, so the dependency is declared and named here rather than inherited
    // by luck.
    "types": ["node"],

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "../../packages/ui/src/**/*.ts",
    "../../packages/ui/src/**/*.vue",
    "../../packages/shared/src/**/*.ts",
    "../../packages/shared/src/**/*.vue",
    "../../packages/master-data/src/**/*.ts",
    "../../packages/master-data/src/**/*.vue",
    "../../packages/platform/src/**/*.ts",
    "../../packages/platform/src/**/*.vue"
  ]
}
