# ============================================================
# FRONTEND ENVIRONMENT VARIABLES
# ============================================================
# Copy this file to .env (or .env.production) and fill in actual values.
# This file IS safe to commit (no secrets).
#
# NOTE: Vite bakes VITE_* vars into the bundle at BUILD time, not runtime.
# Set the correct value BEFORE running `pnpm build`; changing it later
# requires a rebuild.

# ============================================================
# API
# ============================================================
# URL backend API (tanpa trailing slash, TANPA sufiks /api).
# Semua frontend menunjuk ke backend yang SAMA.
# Production: https://api.mts241alikhlash.sch.id
# Development: http://localhost:3000
#
# WAJIB satu registrable domain dengan frontend ini. Cookie refresh dikirim
# SameSite=strict, jadi frontend di domain lain (mis. *.vercel.app sementara
# API di mts241alikhlash.sch.id) tidak akan menerima cookie sama sekali —
# yang rusak bukan cuma sesi bersama antar app, tapi login itu sendiri.
# Ini TIDAK terlihat saat development, karena semua app ada di localhost dan
# port bukan bagian dari "site". Lihat docs/adr/0010.
VITE_API_BASE_URL=http://localhost:3000
