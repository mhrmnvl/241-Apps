model Grade {
  id        String    @id @default(uuid()) @db.Uuid
  level     Int       @unique
  name      String    @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  students           Student[]
  classrooms         Classroom[]
  gradeAcademicYears GradeAcademicYear[]

  @@map("grades")
}

model GradeAcademicYear {
  id             String @id @default(uuid()) @db.Uuid
  gradeId        String @map("grade_id") @db.Uuid
  academicYearId String @map("academic_year_id") @db.Uuid
  curriculumId   String @map("curriculum_id") @db.Uuid

  grade        Grade        @relation(fields: [gradeId], references: [id])
  academicYear AcademicYear @relation(fields: [academicYearId], references: [id])
  curricula    Curricula    @relation(fields: [curriculumId], references: [id])

  @@unique([gradeId, academicYearId])
  @@index([academicYearId])
  @@index([curriculumId])
  @@map("grade_academic_years")
}
