model User {
  id           String    @id @default(uuid()) @db.Uuid
  identifier   String    @unique @db.VarChar(100)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  teacher                Teacher?
  profile                Profile?
  sessions               AuthSession[]
  student                Student?
  userRoles              UserRole[]
  auditLogs              AuditLog[]
  uploadedFiles          File[]
  passwordResetTokens    PasswordResetToken[]
  admissionApplication   AdmissionApplication?
  updatedAppSettings     AppSetting[]
  /// Marks this person corrected in a class they supervise but do not teach.
  correctedStudentScores StudentScore[]        @relation("StudentScoreCorrectedBy")
  // Restrict, not Cascade: a user row backing published portal content cannot be
  // hard-deleted, which is what preserves attribution after deactivation.
  portalPosts            Post[]                @relation("PortalPostAuthor")
  portalPages            PortalPage[]          @relation("PortalPageAuthor")
  portalAgendaEntries    AgendaEntry[]         @relation("PortalAgendaAuthor")
  portalAlbums           GalleryAlbum[]        @relation("PortalAlbumAuthor")

  // Presence keys on the user rather than on Student or Teacher — that is what
  // keeps `presence/` free of any dependency on `academic/` (ADR-0007).
  presenceCredentials     PresenceCredential[]    @relation("PresenceCredentialUser")
  issuedCredentials       PresenceCredential[]    @relation("PresenceCredentialIssuer")
  dailyPresences          DailyPresence[]
  presenceCorrections     PresenceCorrection[]
  workPatternAssignments  WorkPatternAssignment[]
  leaveRequests           LeaveRequest[]          @relation("LeaveRequester")
  approvedLeaveRequests   LeaveRequest[]          @relation("LeaveApprover")
  leaveBalances           LeaveBalance[]
  closedAttendancePeriods AttendancePeriod[]

  salaryAssignments        SalaryAssignment[] @relation("SalaryAssignmentUser")
  createdSalaryAssignments SalaryAssignment[] @relation("SalaryAssignmentCreator")
  createdPayrollRuns       PayrollRun[]       @relation("PayrollRunCreator")
  submittedPayrollRuns     PayrollRun[]       @relation("PayrollRunSubmitter")
  approvedPayrollRuns      PayrollRun[]       @relation("PayrollRunApprover")
  payslips                 Payslip[]

  @@map("users")
}

model AuthSession {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  tokenHash  String    @map("token_hash") @db.VarChar(255)
  userAgent  String?   @map("user_agent") @db.VarChar(512)
  ipAddress  String?   @map("ip_address") @db.VarChar(64)
  expiresAt  DateTime  @map("expires_at")
  lastUsedAt DateTime  @default(now()) @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([tokenHash])
  @@map("auth_sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@map("password_reset_tokens")
}
