enum SchoolUnitStatus {
  PRIVATE
  PUBLIC
}

model SchoolUnitType {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  schoolUnits SchoolUnit[]

  @@map("school_unit_types")
}

model SchoolUnit {
  id        String           @id @default(uuid()) @db.Uuid
  typeId    String?          @map("type_id") @db.Uuid
  name      String           @db.VarChar(200)
  surname   String           @db.VarChar(200)
  nsm       String           @db.VarChar(20)
  npsn      String           @unique @db.VarChar(20)
  status    SchoolUnitStatus
  npwp      String           @db.VarChar(30)
  phone     String           @db.VarChar(15)
  email     String           @db.VarChar(255)
  website   String           @db.VarChar(255)
  isActive  Boolean          @default(true) @map("is_active")
  deletedAt DateTime?        @map("deleted_at")

  // Where the school sits, for the map on its profile. Nullable because the
  // school existed here long before anyone recorded a coordinate, and a
  // profile with no pin is a normal state, not a broken one.
  //
  // Float, not Decimal. Decimal is the right answer for money, where a binary
  // fraction eventually loses a cent; a coordinate has no such duty, and double
  // precision carries far more digits than the ~9 a WGS84 pin needs. It also
  // reaches the client as a JSON number — `Prisma.Decimal` serialises to a
  // string, which every caller would then have to remember to coerce.
  //
  // On SchoolUnit rather than Address: that table is shared with students,
  // teachers and parents, none of whom need a coordinate.
  latitude  Float?
  longitude Float?

  type         SchoolUnitType?         @relation(fields: [typeId], references: [id])
  socialMedias SchoolUnitSocialMedia[]
  addresses    Address[]

  @@map("school_units")
}
