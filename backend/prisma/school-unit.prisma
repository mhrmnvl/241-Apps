enum SchoolUnitStatus {
  PRIVATE
  PUBLIC
}

model SchoolUnitType {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique @db.VarChar(20)
  name     String  @db.VarChar(100)
  isActive Boolean @default(true) @map("is_active")

  schoolUnits SchoolUnit[]

  @@map("school_unit_types")
}

model SchoolUnit {
  id        String           @id @default(uuid()) @db.Uuid
  typeId    String?          @map("type_id") @db.Uuid
  name      String           @db.VarChar(200)
  surname   String           @db.VarChar(200)
  nsm       String           @db.VarChar(20)
  npsn      String           @unique @db.VarChar(20)
  status    SchoolUnitStatus
  npwp      String           @db.VarChar(30)
  phone     String           @db.VarChar(15)
  email     String           @db.VarChar(255)
  website   String           @db.VarChar(255)
  isActive  Boolean          @default(true) @map("is_active")
  deletedAt DateTime?        @map("deleted_at")

  type         SchoolUnitType?         @relation(fields: [typeId], references: [id])
  socialMedias SchoolUnitSocialMedia[]
  addresses    Address[]

  @@map("school_units")
}
