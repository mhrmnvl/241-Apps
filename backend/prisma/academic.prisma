/// School-wide academic policy — the settings that describe how this school
/// runs, rather than what happens on any particular date.
///
/// One row, enforced by the database rather than by convention.
model AcademicSetting {
  id String @id @default(uuid()) @db.Uuid

  /// Carries the constraint and nothing else. A unique index on a column that
  /// only ever holds `true` is what makes "exactly one row" a rule Postgres
  /// keeps, instead of something every writer has to remember.
  singleton Boolean @unique @default(true)

  /// The weekdays school does not run, as a rule rather than as dates.
  ///
  /// 0 is Sunday through 6 is Saturday — the same numbering as
  /// `WorkPatternDay.weekday` and JavaScript's `getDay()`, so the two never
  /// need translating. A six-day week with Sunday off is `[0]`; a five-day
  /// week is `[0, 6]`; a madrasah closing on Friday is `[5]`.
  ///
  /// Applied when the calendar is read, not materialised into ~52 entries a
  /// year. Written out, changing the rule would mean deleting and regenerating
  /// every one of them, and any row missed would go on claiming a holiday that
  /// no longer exists.
  ///
  /// This is the teaching week, which is not the same statement as a work
  /// pattern: the office can be open on a Saturday that runs no classes.
  weeklyHolidays Int[] @default([0]) @map("weekly_holidays")

  /// The pass mark used when nothing more specific says otherwise.
  ///
  /// A subject's pass mark is normally read off the teaching assignment, and
  /// failing that the curriculum. This is the last resort: a subject taught and
  /// graded but never listed in the curriculum for that grade and year, which
  /// is a data gap rather than a normal state. Grading through it beats
  /// refusing to produce the report card.
  ///
  /// Held here because 75 is a school's choice, not a constant of arithmetic —
  /// plenty of madrasah set 70 — and it was hard-coded until now.
  defaultPassingScore Int @default(75) @map("default_passing_score")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("academic_settings")
}

model AcademicYear {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(50)

  /// The calendar year the school year opens in: 2026 for "2026/2027".
  ///
  /// Recorded rather than parsed out of `name`. Academic years are master data
  /// the school edits, so a rename — "TA 2027-2028", a curriculum suffix — would
  /// silently break anything reading the name for order. `SemesterType.sequence`
  /// exists for the same reason, and for the same kind of bug.
  ///
  /// What reads it: the promotion screen, to work out which year follows the
  /// active one without asking. Ordering by this rather than by name is what
  /// keeps "the next year" a fact rather than a guess about spelling.
  startYear Int @map("start_year")

  isActive  Boolean   @default(false) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  classrooms         Classroom[]
  curricula          Curricula[]
  semesters          Semester[]
  academicCalendars  AcademicCalendar[]
  graduations        StudentGraduation[]
  graduationHolds    StudentGraduationHold[]
  admissionWaves     AdmissionWave[]
  gradeAcademicYears GradeAcademicYear[]

  @@map("academic_years")
}

model Semester {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  typeId         String    @map("type_id") @db.Uuid
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  isActive       Boolean   @default(false) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")

  academicCalendars    AcademicCalendar[]
  academicYear         AcademicYear          @relation(fields: [academicYearId], references: [id])
  enrollments          StudentEnrollment[]
  classroomSupervisors ClassroomSupervisor[]
  classroomStructures  ClassroomStructure[]
  teachingAssignments  TeachingAssignment[]
  type                 SemesterType          @relation(fields: [typeId], references: [id])

  @@unique([academicYearId, typeId])
  @@index([isActive])
  @@index([startDate, endDate])
  @@map("semesters")
}

model AcademicCalendar {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  semesterId     String?   @map("semester_id") @db.Uuid
  title          String    @db.VarChar(200)
  typeId         String    @map("type_id") @db.Uuid
  startDate      DateTime  @map("start_date") @db.Date
  endDate        DateTime  @map("end_date") @db.Date
  /// The clock hours the entry runs, when it has any.
  ///
  /// Days are the calendar's unit — a term is July to December, a holiday is
  /// the 17th — and most entries have no time at all. An activity does: a
  /// parents' meeting is the 8th, 08:00 to 12:00. So the hours are optional,
  /// and stored as time-of-day rather than folded into the dates: on a
  /// multi-day activity they read as "these hours, each day", which is how a
  /// school describes it.
  ///
  /// Both or neither. A start with no end is half a statement, and the use case
  /// refuses it rather than printing "08:00 – " on a screen.
  startTime      DateTime? @map("start_time") @db.Time(0)
  endTime        DateTime? @map("end_time") @db.Time(0)
  description    String?   @db.Text
  deletedAt      DateTime? @map("deleted_at")

  academicYear AcademicYear                @relation(fields: [academicYearId], references: [id])
  semester     Semester?                   @relation(fields: [semesterId], references: [id])
  type         AcademicCalendarType        @relation(fields: [typeId], references: [id])
  classrooms   AcademicCalendarClassroom[]

  @@map("academic_calendars")
}

/// Which classes an entry is for. No rows means the whole school.
///
/// The school keeps one calendar, and entries nest in time: a term is one wide
/// entry, and inside it sit the things that happen — some for everyone, some
/// for one class. Absence is the school-wide case on purpose, because that is
/// the common one and it should not need to be spelled out for every holiday.
///
/// This replaces `EventClassroom`, which belonged to a second calendar entity
/// with its own screen, its own permissions and no idea what an academic year
/// was. Two calendars answering the same question is one more than a school can
/// keep straight.
model AcademicCalendarClassroom {
  id                 String @id @default(uuid()) @db.Uuid
  academicCalendarId String @map("academic_calendar_id") @db.Uuid
  classroomId        String @map("classroom_id") @db.Uuid

  academicCalendar AcademicCalendar @relation(fields: [academicCalendarId], references: [id], onDelete: Cascade)
  classroom        Classroom        @relation(fields: [classroomId], references: [id])

  @@unique([academicCalendarId, classroomId])
  @@index([classroomId])
  @@map("academic_calendar_classrooms")
}

model Curricula {
  id             String    @id @default(uuid()) @db.Uuid
  academicYearId String    @map("academic_year_id") @db.Uuid
  name           String    @unique @db.VarChar(100)
  isActive       Boolean   @default(true) @map("is_active")
  deletedAt      DateTime? @map("deleted_at")

  academicYear       AcademicYear        @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  curriculumSubjects CurriculumSubject[]
  gradeAcademicYears GradeAcademicYear[]

  @@index([academicYearId])
  @@map("curricula")
}

model AcademicCalendarType {
  id        String    @id @default(uuid()) @db.Uuid
  name      String    @unique @db.VarChar(50)
  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  academicCalendars AcademicCalendar[]

  @@map("academic_calendar_types")
}

model SemesterType {
  id   String @id @default(uuid()) @db.Uuid
  name String @unique @db.VarChar(50)

  /// Term order within an academic year: Ganjil is 1, Genap is 2.
  ///
  /// Recorded rather than derived. Ordering by `name` sorted the English enum
  /// alphabetically — EVEN before ODD — so every list showed Genap above
  /// Ganjil. Semester types are editable master data, so a rename or a third
  /// type would scramble any ordering that reads the name. New types default
  /// to the end until someone places them.
  sequence Int @default(99)

  isActive  Boolean   @default(true) @map("is_active")
  deletedAt DateTime? @map("deleted_at")

  semesters Semester[]

  @@map("semester_types")
}
