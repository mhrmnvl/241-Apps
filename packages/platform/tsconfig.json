{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "outDir": "./node_modules/.tmp",
    "paths": {
      "@/shared/*": ["../shared/src/*"],
      "@/ui": ["../ui/src/index.ts"],
      "@/ui/*": ["../ui/src/components/ui/*/index.ts"],
      "@/ui/utils": ["../ui/src/utils/index.ts"],
      "@/master-data": ["../master-data/src/index.ts"],
      "@/master-data/*": ["../master-data/src/*"],
      "@/features/platform/*": ["./src/features/*"],
      "@/layouts/AppLayout.vue": ["./src/layouts.d.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "references": [
    { "path": "../shared" },
    { "path": "../ui" },
    { "path": "../master-data" }
  ]
}
