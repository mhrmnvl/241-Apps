{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "baseUrl": ".",
    "outDir": "./node_modules/.tmp",
    "paths": {
      "@/ui": ["./src/index.ts"],
      "@/ui/*": ["./src/components/ui/*/index.ts"],
      "@/ui/utils": ["./src/utils/index.ts"],
      "@/shared/*": ["../shared/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue"],
  "references": [{ "path": "../shared" }]
}
