{
  "name": "241-apps",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10"
  },
  "scripts": {
    "openapi:emit": "pnpm --filter backend openapi:emit",
    "openapi:types": "pnpm openapi:emit && pnpm exec openapi-typescript backend/openapi.json -o packages/shared/src/types/openapi.ts",
    "dev:academic": "pnpm --filter academic-web dev",
    "dev:inventory": "pnpm --filter inventory-web dev",
    "dev:admission": "pnpm --filter admission-web dev",
    "dev:portal": "pnpm --filter portal-web dev",
    "dev:presence": "pnpm --filter presence-web dev",
    "build": "pnpm -r --filter \"*-web\" build",
    "typecheck": "pnpm -r --filter \"*-web\" typecheck",
    "lint": "pnpm -r --filter \"*-web\" lint",
    "lint:strict": "pnpm -r --filter \"*-web\" lint:strict",
    "test": "pnpm -r --filter \"*-web\" --filter \"@241/*\" test",
    "format:check": "pnpm -r --filter \"*-web\" format:check",
    "format": "pnpm -r --filter \"*-web\" format",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@iconify-json/radix-icons": "^1.2.6",
    "@iconify/vue": "^5.0.1",
    "@types/node": "^26.4.0",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.4.1",
    "openapi-typescript": "^7.13.0",
    "prettier": "3.9.6",
    "shadcn-vue": "^2.8.2",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^7.3.3",
    "vite-tsconfig-paths": "^6.1.1",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.3.11"
  }
}
